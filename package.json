{
  "name": "pi-agents-starter",
  "version": "0.1.0",
  "private": true,
  "description": "Starter Pi agent project for learning pi: extensions, skills, prompts, and settings.",
  "type": "module",
  "keywords": [
    "pi-package"
  ],
  "pi": {
    "extensions": [
      "./.pi/extensions/*.ts"
    ],
    "skills": [
      "./.pi/skills/*"
    ],
    "prompts": [
      "./.pi/prompts/*.md"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "scripts": {
    "agent": "pi",
    "agent:spark": "pi --model opencode/muse-spark-1.3",
    "agent:hello": "pi --extension ./.pi/extensions/hello-tool.ts"
  },
  "dependencies": {
    "pg": "^8.23.1"
  }
}
