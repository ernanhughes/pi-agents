{
  "name": "pi-agents-examples",
  "private": true,
  "type": "module",
  "description": "Executable evidence for the code in the Pi Agents manuscript, pinned to the Pi release the book declares.",
  "scripts": {
    "typecheck": "tsc -p .",
    "check-embedded": "node check-embedded.mjs",
    "test": "node --test \"**/*.test.ts\"",
    "verify-examples": "npm run typecheck && npm run check-embedded && npm test",
    "evidence": "node make-evidence.mjs",
    "sync-metadata": "node sync-metadata.mjs"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "1.0.4",
    "@earendil-works/pi-ai": "1.0.4",
    "@earendil-works/pi-coding-agent": "1.0.4"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "5.9.3"
  },
  "allowScripts": {
    "@google/genai@2.21.0": true,
    "esbuild@0.28.2": true,
    "protobufjs@7.6.6": true
  }
}
